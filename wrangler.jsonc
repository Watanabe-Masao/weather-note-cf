{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weather-note-cf",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // The built app. Unknown paths fall back to index.html; /api/* always runs the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Accounts, reports and the ground for analysis (worker/src/accounts.ts). No database_id: the
  // first deploy creates the database; the tables are created by the Worker itself.
  // The report notifications that are due are sent every 5 minutes (worker/src/notify.ts).
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "weather-note" }],
  // Files kept beside the database (worker/src/r2Archive.ts): the telegrams as issued (gzipped) and the
  // daily weather charts. Made by hand in the dashboard (Standard, not public), 2026-11-17.
  // RESEARCH: 空の写真（worker/src/skyPhotos.ts）。利用者の写真なので分ける。2026-11-28 渡辺さんが画面で作った（Standard、公開なし）。
  // 5 GB の上限はアプリの側で数える。外のリポジトリへの控え（offsite.ts）には入れない。
  "r2_buckets": [
    { "binding": "ARCHIVE", "bucket_name": "weather-note-archive" },
    { "binding": "RESEARCH", "bucket_name": "weather-note-research" }
  ],
  // The account, for reading its month's use (worker/src/usage.ts, with the secret CF_ANALYTICS_TOKEN,
  // a read-only token set in the dashboard). An account id is not a secret.
  // ARCHIVE_REPO: the private repository that keeps the off-system copy of R2's originals (worker/src/offsite.ts, #370),
  // written with the secret GITHUB_ARCHIVE_TOKEN (that repository only, Contents read and write). A repository name is not a secret.
  "vars": { "CF_ACCOUNT_ID": "92f4251b54fe77f08c1658592121327e", "ARCHIVE_REPO": "Watanabe-Masao/weather-note-archive" },
  // Needed by `wrangler preview`, which Workers Builds runs for pull requests.
  "previews": {}
}
