# The page itself is always checked again, so a new version shows up on the next open
# (Safari otherwise keeps showing an old build). Built assets have hashed names and never change.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# イベントの日の見出しの絵（docs/event-banner.md）：URL に版（?v=）が付き、差し替えは版を上げるので、変わらない物として。
/event/*
  Cache-Control: public, max-age=31536000, immutable
# The service worker and the manifest are checked on every open, so updates reach installed apps.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
# 台風の進路（scripts/typhoon-tracks.ts）: rebuilt about once a month; a day at the edge and in the browser.
/data/*
  Cache-Control: public, max-age=86400
