{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.research.tsbuildinfo",
    "types": ["node"],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["research", "src", "shared"],
  // research/data has its own dependencies (DuckDB): checked in the research-data workflow, after
  // they are installed (tsconfig.research-data.json).
  "exclude": ["research/data"]
}
