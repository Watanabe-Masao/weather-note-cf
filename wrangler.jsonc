{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weather-note-cf",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // The built app. Unknown paths fall back to index.html; /api/* always runs the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // β③: one Durable Object (with its own SQLite database) per sync key — see worker/src/sync.ts.
  "durable_objects": { "bindings": [{ "name": "SYNC", "class_name": "ReportSync" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReportSync"] }],
  // Needed by `wrangler preview`, which Workers Builds runs for pull requests.
  "previews": {}
}
